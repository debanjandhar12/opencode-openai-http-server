{
  "name": "opencode-openai-http-server",
  "version": "0.0.1",
  "description": "Expose an OpenAI-compatible HTTP server from OpenCode",
  "author": {
    "name": "debanjandhar12",
    "email": "debanjandhar12@gmail.com"
  },
  "type": "module",
  "exports": {
